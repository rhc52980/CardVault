<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CardVault</AssemblyName>

    <!-- Single source of truth for the app version. The backup service reads it
         to detect an update and snapshot the database before carrying on, so it
         has to be bumped on release for that protection to fire. -->
    <Version>1.1.0</Version>
  </PropertyGroup>

  <!-- Stamped in at build time. The version alone can't tell two builds apart
       between releases; this can. -->
  <ItemGroup>
    <AssemblyMetadata Include="BuildDate" Value="$([System.DateTime]::UtcNow.ToString(`yyyy-MM-dd HH:mm`))" />
  </ItemGroup>

  <!-- Never ship the local secrets file. The Web SDK treats every appsettings*.json
       as content, so this would otherwise be copied into the publish output and
       travel with any zip of it. The API key belongs in the database (Settings)
       or in a file placed deliberately on the target machine. -->
  <ItemGroup>
    <Content Update="appsettings.Local.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <!-- So the tests can reach helpers that shouldn't be public API — the price
       statistics, the query building, and the rule for when a backup is owed.
       All worth pinning down, none with any business being called from outside
       the source that owns them. -->
  <ItemGroup>
    <InternalsVisibleTo Include="CardVault.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.11" />
  </ItemGroup>

</Project>
