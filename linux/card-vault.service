[Unit]
Description=CardVault - Pokemon TCG collection tracker
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
ExecStart=/opt/card-vault/CardVault
WorkingDirectory=/opt/card-vault
Restart=on-failure
RestartSec=5

# Runs as its own unprivileged user; the port is above 1024 so no capabilities
# are needed. The collection lives outside the install folder so that updates
# can replace /opt/card-vault wholesale.
User=cardvault
Group=cardvault
Environment=CARDVAULT_DATA_DIR=/var/lib/card-vault

[Install]
WantedBy=multi-user.target
