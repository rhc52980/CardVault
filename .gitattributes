# Line endings are load-bearing here: this repo is edited on Windows but ships
# shell scripts that bash and systemd have to read on Linux. Committed as CRLF,
# install.sh reaches a Linux box with \r on every line and bash rejects it:
# "$'\r': command not found", "set: pipefail: invalid option name".
#
# Scoped deliberately to the file types where the ending matters, so this
# doesn't reformat the whole repository.

# Must be LF - executed by bash / read by systemd.
*.sh        text eol=lf
*.service   text eol=lf

# Must be CRLF - cmd.exe and Windows PowerShell hosts expect it.
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# Never convert.
*.woff2     binary
*.png       binary
*.ico       binary
*.jpg       binary
*.db        binary
*.zip       binary
